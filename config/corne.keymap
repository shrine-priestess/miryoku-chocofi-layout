#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        choccy {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none  &kp SLASH    &kp P            &kp O         &kp U              &kp Y         &kp Q        &kp G               &kp D         &kp L        &kp W        &none
&none  &hml LGUI A  &hml LEFT_ALT H  &hml LCTRL E  &hml LEFT_SHIFT I  &kp COMMA     &kp F        &hmr RIGHT_SHIFT S  &hmr RCTRL T  &hmr LALT N  &hmr LGUI R  &none
&none  &lt 1 SQT    &kp J            &kp X         &kp K              &kp PERIOD    &kp B        &kp C               &kp M         &kp V        &lt 1 Z      &none
                                     &lt 2 ESC     &lt 3 SPACE        &lt 4 TAB     &lt 0 ENTER  &lt 0 BACKSPACE     &lt 5 DELETE
            >;

            label = "choccy";
        };

        nav {
            bindings = <
&none  &none     &none      &none      &none      &kp LS(LC(Z))    &kp CAPS    &none     &none      &none      &none      &none
&none  &kp LGUI  &kp LALT   &kp LCTRL  &kp LSHFT  &kp LC(Y)        &caps_word  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none
&none  &none     &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Z)        &kp INS     &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &none
                            &kp ESC    &kp SPACE  &kp TAB          &kp RET     &kp BSPC  &kp DEL
            >;

            label = "nav";
        };

        num {
            bindings = <
&none  &none     &none     &none      &none      &none    &kp LBKT   &kp N7  &kp N8   &kp N9  &kp RBKT   &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp SEMI   &kp N4  &kp N5   &kp N6  &kp EQUAL  &none
&none  &none     &none     &none      &none      &none    &kp GRAVE  &kp N1  &kp N2   &kp N3  &kp BSLH   &none
                           &none      &none      &none    &kp MINUS  &kp N0  &kp DOT
            >;

            label = "num";
        };

        sym {
            bindings = <
&none  &none     &none     &none      &none      &none    &kp LS(LBRC)   &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)   &kp LS(RBRC)  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp LS(COLON)  &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(PLUS)  &none
&none  &none     &none     &none      &none      &none    &kp LS(TILDE)  &kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)  &kp LS(PIPE)  &none
                           &none      &none      &none    &kp LS(UNDER)  &kp LS(LPAR)  &kp LS(RPAR)
            >;

            label = "sym";
        };

        media {
            bindings = <
&none  &none       &none        &none       &none       &kp C_MUTE      &none  &none         &bt BT_CLR    &none         &none  &none
&none  &kp C_PREV  &kp C_PAUSE  &kp C_PLAY  &kp C_NEXT  &kp C_VOL_UP    &none  &bt BT_SEL 3  &bt BT_SEL 4  &none         &none  &none
&none  &none       &none        &none       &none       &kp C_VOL_DN    &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none
                                &none       &none       &none           &none  &none         &none
            >;

            label = "media";
        };

        func {
            bindings = <
&none  &none     &none     &none      &none      &none    &kp PSCRN        &kp F7  &kp F8  &kp F9  &kp F12  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &none            &kp F4  &kp F5  &kp F6  &kp F11  &none
&none  &none     &none     &none      &none      &none    &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10  &none
                           &none      &none      &none    &none            &none   &none
            >;

            label = "func";
        };
    };
};
